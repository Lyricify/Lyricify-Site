---
import {getLabels} from '@data/DataHelper';
import {Community} from '../data/LyricifyCustomTypes';
import {getSiteTranslationKey, normalizeSiteLocale} from '@utils/siteI18n';

interface Props {
    communities: Array<Community>;
}

const {communities} = Astro.props;

const locale = normalizeSiteLocale(Astro.currentLocale);
const translationKey = getSiteTranslationKey(locale);
const labels = getLabels(locale);
---

<ul>
    {
        communities.map((item) => {
            const communityName =
                item.name instanceof Object
                    ? item.name[translationKey] ?? item.name.en
                    : item.name;
            const communityHasUrl = !!item.url;
            const communityIsFull = !!item.isFull;
            const wordIsFull = labels['label.communityIsFull'][translationKey];
            const communityValue = item.value;

            const tmplWithUrl = (
                <a href={item.url} style='text-decoration: none'>
                    {communityValue}
                </a>
            );
            const tmpl = <code>{item.value}</code>;
            const tmplFull = (
                <>
                    <code>{item.value}</code> ({wordIsFull})
                </>
            );
            const tmplWithUrlFull = (
                <>
                    <a href={item.url} style='text-decoration: none'>
                        {communityValue}
                    </a>{' '}
                    ({wordIsFull})
                </>
            );

            return (
                <li>
                    <p>
                        <b>{communityName}</b>:
                        {communityHasUrl ? (
                            communityIsFull ? (
                                <Fragment set:html={tmplWithUrlFull} />
                            ) : (
                                <Fragment set:html={tmplWithUrl} />
                            )
                        ) : communityIsFull ? (
                            <Fragment set:html={tmplFull} />
                        ) : (
                            <Fragment set:html={tmpl} />
                        )}
                    </p>
                </li>
            );
        })
    }
</ul>

<style>
    ul {
        margin: 0;
        padding-inline-start: 1.25rem;
    }

    li {
        margin-bottom: -0.35rem;
    }

    p {
        margin: 0;
    }
</style>
