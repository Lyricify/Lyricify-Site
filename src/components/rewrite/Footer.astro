---
import Default from '@astrojs/starlight/components/Footer.astro';
import type {Props} from '@astrojs/starlight/props';
import Adaptive from '../Adaptive.astro';

const currentYear = new Date().getFullYear();
const copyrightText = Astro.props.labels['lyricify.copyright'].replace(/\b\d{4}\b/, String(currentYear));
---

<Default {...Astro.props}>
    <slot />
</Default>

<div class='footer-container'>
    <div class='brand not-content'>
        <img
            class='logo'
            src='/Lyricify-icon.png'
            alt='Darker gray Lyricify logo'
        />
        <h1 class='brand-name'>Lyricify</h1>
    </div>

    <div class='credits'>
        <Adaptive mobile>
            <div class='info-item' id='left'>
                <p>
                    {Astro.props.labels['lyricify.madeBy']}
                    <br />
                    {copyrightText}
                </p>
            </div>
            <div class='info-item' id='right'>
                <p>
                    {Astro.props.labels['lyricify.poweredBy']}
                    <br />
                    {
                        Astro.props.labels['lyricify.writtenBy'].replace(
                            /\[CONTRIBUTOR]/,
                            'TSAVPYN & fred913'
                        )
                    }
                </p>
            </div>
        </Adaptive>
    </div>
</div>

<style>
    .footer-container {
        width: 100%;
        text-align: left;
        padding-top: 5rem;
    }

    .footer-container .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    :root .footer-container .brand .logo {
        filter: none;
        width: 3.25rem;
        flex: none;
    }

    .footer-container .brand .brand-name {
        margin: 0;
        font-family: 'Spotify Circular', sans-serif;
        font-size: 1.65rem;
        line-height: 1;
        font-weight: 700;
    }

    div#right {
        text-align: right;
    }

    @media (width < 50rem) {
        .footer-container {
            text-align: center;
        }

        div#right {
            text-align: inherit;
        }
    }

    .footer-container .credits {
        margin-top: 1rem;
    }

    p {
        line-height: 2rem;
    }
</style>
