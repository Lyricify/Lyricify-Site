---
import {getLabels} from '@data/DataHelper';
import {getSiteTranslationKey, normalizeSiteLocale} from '@utils/siteI18n';

interface Props {
    url: string;
}

const {url} = Astro.props;
const locale = normalizeSiteLocale(Astro.currentLocale);
const translationKey = getSiteTranslationKey(locale);
const labels = getLabels(locale);
const language = locale === 'en' ? 'en-us' : 'zh-cn';
const badgeSrc = (theme: 'light' | 'dark') =>
    `https://get.microsoft.com/images/${language}%20${theme}.svg`;
const alt = labels['label.getItFromMicrosoftStore'][translationKey];
---

<a class='store-button not-content' href={url}>
    <img
        src={badgeSrc('dark')}
        alt={alt}
        loading='lazy'
        decoding='async'
        class='store-button__img store-button__img--dark light:sl-hidden'
    />
    <img
        src={badgeSrc('light')}
        alt={alt}
        loading='lazy'
        decoding='async'
        class='store-button__img store-button__img--light dark:sl-hidden'
    />
</a>

<style>
    .store-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 0;
    }

    .store-button__img {
        display: block;
        max-width: 100%;
        width: auto;
        height: auto;
        margin: 0;
    }

    .store-button__img--light {
        transform: translateY(-1.5px);
    }
</style>
