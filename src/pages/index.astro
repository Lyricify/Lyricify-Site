---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import ProductVersionsOverview from '@components/ProductVersionsOverview.astro';
---
<StarlightPage
        frontmatter={{
            title: 'More than lyrics',
            description: 'A powerful lyrics app designed for Spotify',
            template: 'splash',
            head: [
                {
                    tag: 'title',
                    content: 'Lyricify, more than lyrics',
                },
                {
                    tag: 'meta',
                    attrs: {
                        name: 'description',
                        content:
                            'A powerful lyrics app designed for Spotify, along with special features enhancing your music experience.',
                    },
                },
            ],
            hero: {
                title: 'More than lyrics',
                tagline: 'Your ultimate cross-platform lyrics solution',
                actions: [
                    {
                        text: 'Download',
                        link: '/download/',
                        icon: 'right-caret',
                        variant: 'primary',
                    },
                    {
                        text: 'Documentation',
                        link: 'https://docs.lyricify.app/en/',
                        icon: 'external',
                        variant: 'secondary',
                    },
                    {
                        text: 'GitHub Repository',
                        link: 'https://github.com/WXRIW/Lyricify-App',
                        icon: 'external',
                        variant: 'secondary',
                    },
                ],
                image: {
                    html: `<img src="/showcase/showcase1.png" alt="Lyricify" style="width: 100%;"/>`,
                },
            },
        }}>
    <ProductVersionsOverview />
    <hr/>
    <br/>
    <div style='text-align: center;'>
        <h2>Download Lyricify</h2>
        <h4>Open the download page to choose the right edition and download source</h4>
        <p class='cta-row'>
            <a class='docs-guide-link' href='/download/'>
                Open Download Page
            </a>
            <a class='docs-guide-link secondary' href='https://docs.lyricify.app/en/'>
                Documentation
            </a>
        </p>
        <p>
            Compare Lyricify 4, Lyricify Lite, Lyricify Mobile, and the legacy Lyricify 3 in one place.
        </p>
        <h6>
            Need setup details before downloading?
            <a href='https://docs.lyricify.app/en/'>
                Browse the docs
            </a>
        </h6>
    </div>
    <br/>
    <hr/>
    <div class='docs-guide docs-guide-plain'>
        <h2>Need Help Getting Started?</h2>
        <h4>Find installation guides, setup steps, troubleshooting help, and version details in the documentation</h4>
        <p>
            For requirements, step-by-step guides, and detailed usage instructions, visit
            <a href='https://docs.lyricify.app/en/'>docs.lyricify.app</a>.
        </p>
        <p>
            <a class='docs-guide-link' href='https://docs.lyricify.app/en/'>
                Browse the Documentation
            </a>
        </p>
    </div>
    <hr/>
    <br/>
    <div class='community-section'>
        <div class='community-copy'>
            <h2>You Are with Lyricify</h2>
            <h4>Join our community</h4>
            <p>
                Find official QQ communities and Telegram channels in one place. If you want to contact the Lyricify developer or reach out to the Lyricify team, this is the page to start from.
            </p>
            <p class='cta-row'>
                <a class='docs-guide-link' href='/community/'>
                    Open Community Page
                </a>
            </p>
        </div>
    </div>
</StarlightPage>

<style>
    .docs-guide {
        text-align: center;
        padding: 1.5rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 1rem;
        background:
            linear-gradient(135deg, var(--sl-color-accent-low), transparent 65%),
            var(--sl-color-black);
    }

    .docs-guide-link {
        display: inline-block;
        padding: 0.8rem 1.2rem;
        border-radius: 999px;
        text-decoration: none;
        color: var(--sl-color-white);
        background: color-mix(in srgb, var(--sl-color-accent-low) 40%, var(--sl-color-black));
        font-weight: 700;
        border: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 55%, transparent);
    }

    :root[data-theme='light'] .docs-guide-link {
        color: var(--sl-color-accent-high);
        background: var(--sl-color-accent-low);
        border-color: color-mix(in srgb, var(--sl-color-accent) 24%, transparent);
    }

    .docs-guide-plain {
        padding-inline: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
    }

    .cta-row {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .community-section {
        text-align: center;
        padding-inline: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
    }

    .community-copy {
        text-align: center;
    }

    .community-copy p:not(.cta-row) {
        color: var(--sl-color-gray-2);
    }

</style>
