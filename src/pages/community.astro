---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import Communities from '@components/Communities.astro';
import {Data} from '@data/DataHelper';
---

<StarlightPage
        frontmatter={{
            title: 'Community',
            description: 'Join the Lyricify community on QQ and Telegram.',
            template: 'splash',
            hero: {
                title: 'Lyricify Community',
                tagline: 'Join QQ groups and Telegram groups and channels to connect with Lyricify users and the developer.',
            },
        }}>
    <div class='community-layout'>
        <section class='community-panel' id='qq'>
            <div class='community-panel-head'>
                <h2>QQ Groups</h2>
                <p>Join one of the official QQ groups to chat with other users.</p>
            </div>
            <Communities communities={Data['Community.QQ']} />
        </section>
        <div class='community-right'>
            <section class='community-panel' id='telegram'>
                <div class='community-panel-head'>
                    <h2>Telegram</h2>
                    <p>Follow the user group and release channel on Telegram.</p>
                </div>
                <Communities communities={Data['Community.Telegram']} />
            </section>
            <section class='community-panel' id='github'>
                <div class='community-panel-head'>
                    <h2>GitHub</h2>
                    <p>You can report issues, share feedback, and start discussions through GitHub Issues.</p>
                </div>
                <Communities communities={Data['Community.GitHub']} />
            </section>
            <section class='community-panel' id='email'>
                <div class='community-panel-head'>
                    <h2>Email</h2>
                    <p>You can reach the Lyricify developer by email. If you write in, please include the reason for your message.</p>
                </div>
                <Communities communities={Data['Community.Email']} />
            </section>
        </div>
        <section class='beta-panel' id='beta'>
            <div class='community-panel-head beta-head'>
                <h2>Beta Groups</h2>
                <p>If you want early access to new features, want to follow development progress, and are willing to test and provide feedback, you are welcome to join.</p>
            </div>
            <Communities communities={Data['Community.Beta']} />
        </section>
    </div>
</StarlightPage>

<style>
    :global(.hero .copy > *) {
        max-width: none;
    }

    :global(.hero .tagline) {
        max-width: none;
    }

    @media (min-width: 50rem) {
        :global(.hero) {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }

    .community-layout {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .community-right {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .community-panel {
        box-sizing: border-box;
        margin: 0;
        margin-block-start: 0;
        padding: 1.4rem;
        position: relative;
        top: 0;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 1rem;
        background:
            linear-gradient(135deg, color-mix(in srgb, var(--sl-color-accent-low) 50%, transparent), transparent 70%),
            var(--sl-color-black);
    }

    .community-panel p {
        color: var(--sl-color-gray-2);
    }

    .community-panel-head {
        min-height: 5.5rem;
        margin-bottom: 1rem;
    }

    .community-panel-head h2 {
        margin: 0 0 0.5rem;
        line-height: 1.08;
    }

    .community-panel-head p {
        margin: 0;
    }

    .community-panel :global(ul) {
        margin: 0;
    }

    .beta-panel {
        box-sizing: border-box;
        margin: 0;
        margin-block-start: 0;
        padding: 1.4rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 1rem;
        background:
            linear-gradient(135deg, color-mix(in srgb, var(--sl-color-accent-low) 50%, transparent), transparent 70%),
            var(--sl-color-black);
    }

    .beta-head {
        min-height: 5.5rem;
        margin-bottom: 1.25rem;
    }

    .beta-note {
        margin: 0.9rem 0 0;
        color: var(--sl-color-gray-2);
    }

    @media (min-width: 50rem) {
        .community-layout {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            grid-template-areas:
                'qq right'
                'beta right';
            gap: 1.25rem;
            align-items: start;
        }

        .community-layout > * {
            align-self: start;
            margin-top: 0 !important;
            margin-block-start: 0 !important;
        }

        #qq {
            grid-area: qq;
        }

        #beta {
            grid-area: beta;
            margin-top: 0;
        }

        .community-right {
            grid-area: right;
        }
    }
</style>
